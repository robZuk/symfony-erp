{% extends 'layout.html.twig' %}

{% block title %}Użytkownicy – Mini-ERP{% endblock %}
{% block heading %}Użytkownicy{% endblock %}

{% block page %}
    <div class="flex flex-wrap items-end justify-between gap-2">
        <form method="get" action="{{ path('identity_user_index') }}" class="flex flex-wrap items-end gap-2" role="search" data-controller="auto-submit" data-turbo-frame="results">
            <twig:Input type="search" name="q" value="{{ filter.q }}" placeholder="Szukaj po nazwisku lub e-mailu" aria-label="Szukaj" class="w-64" />
            <twig:NativeSelect size="sm" name="status" aria-label="Status">
                <option value="all"{{ filter.status == 'all' ? ' selected' }}>Wszyscy</option>
                <option value="active"{{ filter.status == 'active' ? ' selected' }}>Aktywni</option>
                <option value="blocked"{{ filter.status == 'blocked' ? ' selected' }}>Zablokowani</option>
            </twig:NativeSelect>
            <twig:Button type="submit" variant="outline" data-auto-submit-target="submit">Szukaj</twig:Button>
        </form>

        <twig:Button as="a" href="{{ path('identity_user_new') }}">
            <twig:ux:icon name="lucide:plus" data-icon="inline-start" aria-hidden="true" />
            Dodaj użytkownika
        </twig:Button>
    </div>

    {# Only this part is replaced when the filters change, so the form above keeps its focus.
       Links inside lead to other pages (target="_top"); the address bar follows the filters without adding a history entry for each one ("replace"). #}
    <turbo-frame id="results" target="_top" data-turbo-action="replace" class="flex flex-col gap-4">
        <twig:Card class="py-0">
            <twig:Table>
                <twig:Table:Header>
                    <twig:Table:Row>
                        <twig:Table:Head>Imię i nazwisko</twig:Table:Head>
                        <twig:Table:Head>E-mail</twig:Table:Head>
                        <twig:Table:Head>Role</twig:Table:Head>
                        <twig:Table:Head>Status</twig:Table:Head>
                        <twig:Table:Head><span class="sr-only">Akcje</span></twig:Table:Head>
                    </twig:Table:Row>
                </twig:Table:Header>
                <twig:Table:Body>
                    {% for user in page.items %}
                        <twig:Table:Row data-test="user-row" class="{{ user.active ? '' : 'text-muted-foreground' }}">
                            <twig:Table:Cell class="font-medium">
                                {{ user.fullName }}
                                {% if user == app.user %}<span class="font-normal text-muted-foreground">(Ty)</span>{% endif %}
                            </twig:Table:Cell>
                            <twig:Table:Cell>{{ user.email }}</twig:Table:Cell>
                            <twig:Table:Cell>
                                <div class="flex flex-wrap gap-1">
                                    {% for role in user.assignedRoles %}
                                        <twig:Badge variant="secondary">{{ constant('App\\Identity\\Entity\\User::ROLE_LABELS')[role] ?? role }}</twig:Badge>
                                    {% else %}
                                        <span class="text-muted-foreground">tylko podgląd</span>
                                    {% endfor %}
                                </div>
                            </twig:Table:Cell>
                            <twig:Table:Cell>
                                {% if user.active %}
                                    <twig:Badge variant="secondary">Aktywny</twig:Badge>
                                {% else %}
                                    <twig:Badge variant="outline">Zablokowany</twig:Badge>
                                {% endif %}
                            </twig:Table:Cell>
                            <twig:Table:Cell>
                                <div class="flex justify-end gap-1">
                                    <twig:Button as="a" variant="ghost" size="sm" href="{{ path('identity_user_edit', {id: user.id}) }}">Edytuj</twig:Button>
                                    {# Not while already working as someone else, and never as a blocked account.
                                        The link goes to the home page: this list is closed to everyone but administrators. #}
                                    {% if user != app.user and user.active and not is_granted('IS_IMPERSONATOR') %}
                                        <twig:Button as="a" variant="ghost" size="sm" href="{{ path('app_dashboard', {_switch_user: user.email}) }}" title="Zobacz system oczami tego użytkownika">Pracuj jako</twig:Button>
                                    {% endif %}
                                    {% if user != app.user %}
                                        <form method="post" action="{{ path('identity_user_toggle', {id: user.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('identity_user_toggle') }}">
                                            <twig:Button type="submit" variant="ghost" size="sm">{{ user.active ? 'Zablokuj' : 'Odblokuj' }}</twig:Button>
                                        </form>
                                    {% endif %}
                                </div>
                            </twig:Table:Cell>
                        </twig:Table:Row>
                    {% else %}
                        <twig:Table:Row>
                            <twig:Table:Cell colspan="5" class="h-24 text-center text-muted-foreground">Brak użytkowników spełniających kryteria.</twig:Table:Cell>
                        </twig:Table:Row>
                    {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        </twig:Card>

        <twig:Pager :page="page" route="identity_user_index" :query="filter.toQuery()" />
    </turbo-frame>
{% endblock %}
