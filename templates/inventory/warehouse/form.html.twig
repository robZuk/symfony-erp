{% extends 'layout.html.twig' %}

{% set heading = warehouse.id ? 'Edycja magazynu' : 'Nowy magazyn' %}

{% block title %}{{ heading }} – System ERP{% endblock %}
{% block heading %}{{ heading }}{% endblock %}

{% block page %}
    <twig:Card class="max-w-xl">
        <twig:Card:Content>
            {{ form_start(form, {attr: {class: 'grid gap-6', novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}

                <div class="grid gap-6 sm:grid-cols-3">
                    {{ form_row(form.code) }}
                    <div class="sm:col-span-2">{{ form_row(form.name) }}</div>
                </div>

                <div class="flex justify-end gap-2">
                    <twig:Button as="a" variant="outline" href="{{ path('inventory_warehouse_index') }}">Anuluj</twig:Button>
                    <twig:Button type="submit">Zapisz</twig:Button>
                </div>
            {{ form_end(form) }}
        </twig:Card:Content>
    </twig:Card>
{% endblock %}
