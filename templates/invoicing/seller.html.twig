{% extends 'layout.html.twig' %}

{% block title %}Dane firmy – System ERP{% endblock %}
{% block heading %}Dane firmy{% endblock %}

{% block page %}
    <twig:Card class="max-w-2xl">
        <twig:Card:Header>
            <twig:Card:Description>
                Sprzedawca drukowany na fakturach. Zmiana dotyczy tylko nowych dokumentów: wystawione faktury zachowują dane z dnia wystawienia.
            </twig:Card:Description>
        </twig:Card:Header>
        <twig:Card:Content>
            {{ form_start(form, {attr: {class: 'grid gap-6', novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}

                <div class="grid gap-6 sm:grid-cols-3">
                    <div class="sm:col-span-2">{{ form_row(form.name) }}</div>
                    {{ form_row(form.nip) }}
                </div>
                {{ form_row(form.street) }}
                <div class="grid gap-6 sm:grid-cols-3">
                    {{ form_row(form.postalCode) }}
                    <div class="sm:col-span-2">{{ form_row(form.city) }}</div>
                </div>
                {{ form_row(form.bankAccount) }}

                <div class="flex justify-end">
                    <twig:Button type="submit">Zapisz</twig:Button>
                </div>
            {{ form_end(form) }}
        </twig:Card:Content>
    </twig:Card>
{% endblock %}
