{% extends 'layout.html.twig' %}

{% block title %}Faktury – Mini-ERP{% endblock %}
{% block heading %}Faktury{% endblock %}

{% block page %}
    <form method="get" action="{{ path('invoicing_invoice_index') }}" class="flex flex-wrap items-end gap-2" role="search">
        <twig:Input type="search" name="q" value="{{ filter.q }}" placeholder="Szukaj po numerze, nabywcy lub NIP" aria-label="Szukaj" class="w-72" />
        <twig:NativeSelect size="sm" name="type" aria-label="Rodzaj">
            <option value="">Wszystkie</option>
            <option value="invoice"{{ filter.type == 'invoice' ? ' selected' }}>Faktury</option>
            <option value="correction"{{ filter.type == 'correction' ? ' selected' }}>Korekty</option>
        </twig:NativeSelect>
        <twig:Button type="submit" variant="outline">Szukaj</twig:Button>
    </form>

    <twig:Card class="py-0">
        <twig:Table>
            <twig:Table:Header>
                <twig:Table:Row>
                    <twig:Table:Head>Numer</twig:Table:Head>
                    <twig:Table:Head>Data wystawienia</twig:Table:Head>
                    <twig:Table:Head>Nabywca</twig:Table:Head>
                    <twig:Table:Head>Termin płatności</twig:Table:Head>
                    <twig:Table:Head class="text-end">Netto</twig:Table:Head>
                    <twig:Table:Head class="text-end">Brutto</twig:Table:Head>
                </twig:Table:Row>
            </twig:Table:Header>
            <twig:Table:Body>
                {% for invoice in page.items %}
                    <twig:Table:Row data-test="invoice-row">
                        <twig:Table:Cell class="font-medium">
                            <a href="{{ path('invoicing_invoice_show', {id: invoice.id}) }}" class="underline-offset-4 hover:underline">{{ invoice.number }}</a>
                            {% if invoice.correction %}<twig:Badge variant="outline" class="ms-1">korekta</twig:Badge>{% endif %}
                        </twig:Table:Cell>
                        <twig:Table:Cell>{{ invoice.issueDate|date('d.m.Y') }}</twig:Table:Cell>
                        <twig:Table:Cell>{{ invoice.buyer.name }}</twig:Table:Cell>
                        <twig:Table:Cell>{{ invoice.dueDate|date('d.m.Y') }}</twig:Table:Cell>
                        <twig:Table:Cell class="text-end tabular-nums">{{ invoice.netTotal|money }}</twig:Table:Cell>
                        <twig:Table:Cell class="text-end tabular-nums">{{ invoice.grossTotal|money }}</twig:Table:Cell>
                    </twig:Table:Row>
                {% else %}
                    <twig:Table:Row>
                        <twig:Table:Cell colspan="6" class="h-24 text-center text-muted-foreground">Brak faktur spełniających kryteria. Fakturę wystawia się ze strony wydanego zamówienia.</twig:Table:Cell>
                    </twig:Table:Row>
                {% endfor %}
            </twig:Table:Body>
        </twig:Table>
    </twig:Card>

    <twig:Pager :page="page" route="invoicing_invoice_index" :query="filter.toQuery()" />
{% endblock %}
